# Copy this file to ".env" and fill in the values. Never commit ".env".

# Drishti API key. Set it here so people using the app only need an AI model key.
# Leave it empty to ask each user for their own key in the app.
DRISHTI_API_KEY=""

# Drishti MCP server. You normally do not need to change this.
DRISHTI_MCP_URL="https://mcp.drishti.manasija.in"

# Secret used to encrypt the API keys users save in the browser.
# Optional for local use. Required in production; any long random string works,
# for example the output of: openssl rand -base64 32
API_KEY_ENCRYPTION_SECRET=""
