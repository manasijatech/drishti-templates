{
	"name": "corporate-action-lifecycle-monitor",
	"version": "1.0.0",
	"private": true,
	"license": "MIT",
	"packageManager": "bun@1.3.13",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"dev": "next dev",
		"dev:api": "bun --watch apps/api/src/index.ts",
		"start:api": "bun apps/api/src/index.ts",
		"build": "next build",
		"start": "next start",
		"test": "bun test apps/api",
		"typecheck": "tsc --noEmit",
		"env:validate": "bun env.config.ts",
		"lint": "biome check",
		"format": "biome format --write",
		"profile:announcements": "bun apps/api/scripts/profile-announcement-exports.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.3",
		"@envin/cli": "^1.2.0",
		"@tailwindcss/postcss": "^4.3.2",
		"@types/bun": "^1.4.2",
		"@types/node": "^26.1.1",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"tailwindcss": "^4.3.2",
		"typescript": "^5.9.3"
	},
	"dependencies": {
		"@base-ui/react": "^1.6.0",
		"@phosphor-icons/react": "^2.1.10",
		"@scalar/hono-api-reference": "0.12.1",
		"@tanstack/react-query": "^5.101.2",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"drishti-sdk": "1.0.15",
		"envin": "^1.2.0",
		"hono": "4.13.7",
		"mongoose": "8.24.4",
		"next": "^16.2.10",
		"openai": "^7.15.0",
		"radix-ui": "^1.6.2",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"shadcn": "^4.13.0",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.6.0",
		"tw-animate-css": "^1.4.0",
		"zod": "^4.4.3"
	}
}
