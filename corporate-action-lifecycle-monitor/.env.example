# Required for live corporate-action ingestion.
DRISHTI_API_KEY=""

# MongoDB used by the lifecycle API.
MONGODB_URI="mongodb://localhost:27017/corporate_actions"
MONGODB_MAX_POOL_SIZE="10"

# Frontend/API routing.
API_INTERNAL_URL="http://localhost:4000"
PUBLIC_API_URL="http://localhost:4000"
FRONTEND_ORIGIN="http://localhost:3000"
NEXT_PUBLIC_LIFECYCLE_WS_URL="ws://localhost:4000/ws/lifecycles"

# Optional advisory validation. The app works without this key.
OPENROUTER_API_KEY=""
